{
    "name": "contao-garage/contao-page-400",
    "description": "Adds two page types responding with a 400 status code caused by either a bad request exception or by an invalid token exception.",
    "license": "MIT",
    "type": "contao-bundle",
    "keywords": ["contao bundle", "page controller error 400", "bad request", "invalid request token"],
    "support": {
        "issues": "https://github.com/contao-garage/contao-page-400/issues",
        "source": "https://github.com/contao-garage/contao-page-400"
    },
    "homepage": "https://contao-garage.de",
    "license": "MIT",
    "authors": [
        {
            "name": "Martin Schumann",
            "homepage": "https://github.com/martinschumann"
        }
    ],
    "require": {
        "php": "^8.2",
        "contao/core-bundle": "^5.3"
    },
    "require-dev": {
        "contao/easy-coding-standard": "^6.13",
        "contao/rector": "^1.3"
    },
    "autoload": {
        "psr-4": {
            "ContaoGarage\\Page400\\": "src/"
        },
        "classmap": [
            "contao/"
        ],
        "exclude-from-classmap": [
            "contao/dca/",
            "contao/languages/"
        ]
    },
    "extra": {
        "contao-manager-plugin": "ContaoGarage\\Page400\\ContaoManager\\Plugin"
    },
    "config": {
        "allow-plugins": {
            "contao-components/installer": true,
            "php-http/discovery": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
